# Copy to .env and edit:  cp .env.example .env
# Never commit a real .env file. It is in .gitignore.

# --- Required (api and worker) ------------------------------------------------
# PostgreSQL:  postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://pollie:devpass@localhost:5432/pollie
# Redis:       redis://HOST:6379
REDIS_URL=redis://localhost:6379

# --- Common --------------------------------------------------------------------
# Reported by /healthz, /metrics and the logs. Your pipeline should set it to the image tag.
APP_VERSION=0.1.1
# debug | info | warn | error
LOG_LEVEL=info
# json (one object per line, for log pipelines) or text (readable while developing)
LOG_FORMAT=json

# --- API -----------------------------------------------------------------------
# Used only by `python -m pollie.api`. With uvicorn pass --host and --port instead.
API_HOST=0.0.0.0
API_PORT=8000
# Comma separated origins allowed to call the API from a browser. Empty = same origin only
# (the web container proxies /api, so you normally leave this empty).
CORS_ORIGINS=
MAX_OPTIONS=10
MAX_QUESTION_LENGTH=200
# Seconds a poll's results stay cached in Redis.
RESULTS_CACHE_TTL=5

# --- Worker --------------------------------------------------------------------
# Port for the worker's /healthz, /readyz and /metrics.
WORKER_METRICS_PORT=9100
WORKER_POLL_SECONDS=2
# A vote that cannot be stored after this many attempts goes to the dead letter queue.
WORKER_MAX_ATTEMPTS=5

# --- Web (development server only) -----------------------------------------------
API_URL=http://localhost:8000
WEB_PORT=8080
